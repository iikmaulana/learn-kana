# OpenAI API Configuration
OPENAI_API_KEY=your-api-key-here

# Google AI Studio (Gemini) API Key for Materi Chat (optional)
VITE_GEMINI_API_KEY=

# ElevenLabs API Key & Voice ID for natural AI tutor voice in Chat (optional)
# Uses model eleven_multilingual_v2 with automatic fallback to Web Speech API
VITE_ELEVENLABS_API_KEY=your-elevenlabs-bot-api-key-here
VITE_ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL

# ElevenLabs API Key & Voice ID for learner message pronunciation in Chat (optional)
VITE_ELEVENLABS_USER_API_KEY=your-elevenlabs-user-api-key-here
VITE_ELEVENLABS_USER_VOICE_ID=r6PXps8L8e51YofYDNqb

# Umami analytics (optional, leave empty to disable tracking).
# Read at build time: rebuild the app / Docker image after changing them.
REACT_APP_UMAMI_SCRIPT_URL=
REACT_APP_UMAMI_WEBSITE_ID=

# Public address of the site (optional), e.g. https://example.com or
# https://user.github.io/learn-kana. Read at build time: adds the canonical
# link, absolute link-preview image (og:image) and sitemap.xml to the build.
SITE_URL=

# Docker: port on the host machine where the app is served (http://localhost:APP_PORT)
APP_PORT=3000

