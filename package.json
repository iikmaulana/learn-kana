{
  "name": "learn-kana",
  "version": "0.2.0",
  "private": true,
  "homepage": ".",
  "dependencies": {
    "lucide-react": "^1.54.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.14.0",
    "wanakana": "^5.3.1",
    "workbox-core": "^6.6.0",
    "workbox-expiration": "^6.6.0",
    "workbox-precaching": "^6.6.0",
    "workbox-routing": "^6.6.0",
    "workbox-strategies": "^6.6.0"
  },
  "scripts": {
    "start": "vite",
    "build": "vite build && node scripts/seo-postbuild.mjs",
    "preview": "vite preview",
    "check:bundle": "node scripts/check-bundle.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint --max-warnings=0 --ext .js src",
    "fonts": "node scripts/subset-fonts.mjs"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/react": "^13.4.0",
    "@vitejs/plugin-react": "4.4.1",
    "eslint": "8.57.1",
    "eslint-config-react-app": "7.0.1",
    "jsdom": "26.1.0",
    "subset-font": "^2.9.0",
    "vite": "6.3.5",
    "vite-plugin-pwa": "1.0.0",
    "vitest": "3.1.4"
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ],
    "ignorePatterns": [
      "src/fillWithOpenAI.js"
    ],
    "overrides": [
      {
        "files": [
          "src/**/*.test.js",
          "src/setupTests.js"
        ],
        "env": {
          "jest": true,
          "es2020": true
        },
        "globals": {
          "vi": "readonly"
        }
      }
    ]
  }
